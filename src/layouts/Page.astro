---
import Base from "./Base.astro";
interface Props { title: string; description: string; heading?: string; lead?: string; noindex?: boolean }
const { title, description, heading = title, lead, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="wrap page">
    <header class="p-head">
      <h1>{heading}</h1>
      {lead && <p class="p-lead">{lead}</p>}
    </header>
    <div class="prose"><slot /></div>
  </div>
</Base>
<style>
  .page { padding-top: 28px; }
  .p-head { max-width: 760px; border-top: 4px solid var(--sirene); padding-top: 14px; }
  h1 { margin: 0; font: 700 clamp(2rem, 1.4rem + 2.4vw, 3rem)/1.02 var(--display); }
  .p-lead { margin: 12px 0 0; font: 1.2rem/1.5 var(--serif); color: var(--tinta-2); }
  .prose { max-width: 760px; margin-top: 24px; font: 1.08rem/1.7 var(--serif); }
  .prose :global(h2) { font: 700 1.5rem/1.15 var(--display); margin: 1.6em 0 0.5em; }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(a:not(.btn)) { color: var(--sirene-escura); text-decoration: underline; }
  .prose :global(ul) { padding-left: 1.2em; }
</style>
