---
import ListPage from "../../components/ListPage.astro";
import { latest, mostRead } from "../../lib/db";
import { CATEGORIES, SITE } from "../../lib/config";

const cat = Astro.params.cat ?? "";
if (!(cat in CATEGORIES)) return Astro.rewrite("/404");
const name = CATEGORIES[cat];
const page = Math.max(1, Number(Astro.url.searchParams.get("pagina") ?? "1") || 1);
const PER = 20;
const [rows, top] = await Promise.all([latest(PER + 1, (page - 1) * PER, { category: cat }), mostRead(3, 5)]);
---
<ListPage
  heading={name}
  intro={`Notícias de ${name.toLowerCase()} em Embu das Artes, Taboão da Serra, Itapecerica da Serra e Zona Sul de SP.`}
  title={`${name}: notícias de Embu, Taboão, Itapecerica e Zona Sul`}
  description={`Últimas notícias de ${name.toLowerCase()} da região de Embu das Artes, Taboão da Serra, Itapecerica da Serra e Zona Sul de São Paulo, na ${SITE.name}.`}
  path={`/editoria/${cat}/`}
  posts={rows.slice(0, PER)}
  mostRead={top}
  page={page}
  hasNext={rows.length > PER}
/>
