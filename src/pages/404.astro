---
import Base from "../layouts/Base.astro";
import Story from "../components/Story.astro";
import { latest } from "../lib/db";
const rows = await latest(6).catch(() => []);
Astro.response.status = 404;
---
<Base title="Página não encontrada" noindex>
  <div class="wrap nf">
    <h1>Essa página não existe mais</h1>
    <p>O endereço pode ter mudado. Use a busca ou veja as últimas notícias.</p>
    <form action="/busca/" method="get" role="search"><input name="q" type="search" placeholder="Buscar notícias" aria-label="Buscar notícias" /><button class="btn btn-sirene">Buscar</button></form>
    <div class="g">{rows.map((p) => <Story post={p} variant="tile" />)}</div>
  </div>
</Base>
<style>
  .nf { padding-top: 32px; }
  h1 { font: 700 2.4rem/1 var(--display); margin: 0 0 10px; }
  form { display: flex; gap: 8px; max-width: 480px; margin: 18px 0 32px; }
  input { flex: 1; padding: 12px 16px; border: 1.5px solid var(--linha); border-radius: 999px; font: 1rem var(--ui); }
  .g { display: grid; gap: 24px; }
  @media (min-width: 700px) { .g { grid-template-columns: repeat(3, 1fr); } }
</style>
