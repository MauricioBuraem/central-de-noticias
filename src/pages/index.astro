---
import Base from "../layouts/Base.astro";
import Story from "../components/Story.astro";
import Sidebar from "../components/Sidebar.astro";
import AdSlot from "../components/AdSlot.astro";
import Breaking from "../components/Breaking.astro";
import Icon from "../components/Icon.astro";
import { breaking, latest, mostRead, pinned, videos, type Card } from "../lib/db";
import { CITIES, SITE, type CityKey } from "../lib/config";
import { absolute, cityOf, focusStyle, img, postPath } from "../lib/format";

const cityKeys: CityKey[] = ["embu", "taboao", "itapecerica", "zona-sul"];
const [recent, pins, urgent, top, reels, ...perCity] = await Promise.all([
  latest(36),
  pinned(),
  breaking(),
  mostRead(3, 5),
  videos(10),
  ...cityKeys.map((c) => latest(4, 0, { city: c })),
]);

const used = new Set<string>(pins.map((p) => p.id));
const take = (rows: Card[], n: number) => {
  const out: Card[] = [];
  for (const r of rows) {
    if (out.length >= n) break;
    if (!used.has(r.id)) {
      out.push(r);
      used.add(r.id);
    }
  }
  return out;
};
const [lead, ...side] = take(recent, 3);
const strip = take(recent, 4);
const feed = take(recent, 14);

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: [lead, ...side, ...strip].filter(Boolean).map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: absolute(postPath(p)),
  })),
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: absolute("/"),
  potentialAction: { "@type": "SearchAction", target: absolute("/busca/?q={q}"), "query-input": "required name=q" },
};
---
<Base title={SITE.name} isHome jsonLd={[website, itemList]}>
  <Breaking slot="top" posts={urgent} />

  <div class="wrap home">
    {pins.length > 0 && (
      <section class="destaque" aria-label="Em destaque">
        {pins.slice(0, 1).map((p) => (
          <a href={postPath(p)} class="destaque-in" style={`--cor:${cityOf(p.city).color}`}>
            <div class="ph r169">
              {p.cover_path && <img src={img(p.cover_path, 640)} width="640" height="360" alt={p.cover_alt ?? ""} style={focusStyle(p, 16 / 9)} loading="eager" />}
            </div>
            <div class="destaque-txt">
              <span class="selo">Em destaque</span>
              <span class="chapeu">{cityOf(p.city).name}</span>
              <h2 class="t t-l">{p.title}</h2>
              {p.excerpt && <p>{p.excerpt}</p>}
            </div>
          </a>
        ))}
      </section>
    )}

    {lead && (
      <section class="manchetes" aria-label="Manchetes">
        <div class="m-lead"><Story post={lead} variant="lead" eager showExcerpt headingLevel={2} /></div>
        <div class="m-side">{side.map((p) => <Story post={p} variant="tile" />)}</div>
      </section>
    )}

    {strip.length > 0 && (
      <section class="faixa-4" aria-label="Mais notícias">
        {strip.map((p) => <Story post={p} variant="tile" />)}
      </section>
    )}

    <div class="ad-leader"><AdSlot size="leader" /></div>

    <div class="grid-main">
      <section aria-labelledby="ult-h">
        <div class="sec-h" style="--cor:var(--sirene)"><h2 id="ult-h">Últimas notícias</h2><a href="/ultimas/">Ver todas</a></div>
        <div class="feed">
          {feed.map((p, i) => (
            <>
              <Story post={p} variant="row" showExcerpt={i < 4} />
              {i === 5 && <div class="feed-ad"><AdSlot size="inline" /></div>}
            </>
          ))}
        </div>
        <div class="more"><a class="btn" href="/ultimas/?pagina=2">Ver mais notícias</a></div>
      </section>
      <Sidebar mostRead={top} />
    </div>

    {reels.length > 2 && (
      <section class="videos" aria-labelledby="vid-h">
        <div class="sec-h"><h2 id="vid-h">Vídeos</h2><a href="https://www.instagram.com/centraldenoticias24h/reels/" target="_blank" rel="noopener">Ver no Instagram</a></div>
        <div class="rail">
          {reels.map((p) => <Story post={p} variant="reel" />)}
        </div>
      </section>
    )}

    <div class="cidades">
      {cityKeys.map((key, i) => {
        const rows = perCity[i] as Card[];
        if (!rows.length) return null;
        const c = CITIES[key];
        const [first, ...rest] = rows;
        return (
          <section class="cidade" style={`--cor:${c.color}`} aria-labelledby={`c-${key}`}>
            <div class="sec-h"><h2 id={`c-${key}`}>{c.name}</h2><a href={c.path}>Mais de {c.short}</a></div>
            <Story post={first} variant="tile" />
            <div class="c-list">{rest.map((p) => <Story post={p} variant="compact" />)}</div>
          </section>
        );
      })}
    </div>

    <section class="envie-band" aria-label="Envie sua notícia">
      <Icon name="megaphone" size={34} />
      <div>
        <p class="eb-t">A Central é feita com você</p>
        <p>Grande parte das notícias que publicamos começa com um vídeo ou um aviso de quem mora aqui.</p>
      </div>
      <a class="btn btn-whats" href="/envie-sua-noticia/"><Icon name="whatsapp" />Enviar notícia</a>
    </section>
  </div>
</Base>

<style>
  .home {
    padding-top: 20px;
  }
  .destaque {
    margin-bottom: 24px;
  }
  .destaque-in {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
    padding: 12px;
    border-radius: 10px;
    background: #fff6df;
    box-shadow: inset 0 0 0 1px #f3dfa6;
  }
  .destaque-in .ph {
    aspect-ratio: 1;
  }
  .destaque-txt p {
    display: none;
  }
  .destaque-txt .t {
    font-size: 1.1rem;
  }
  @media (min-width: 760px) {
    .destaque-in {
      grid-template-columns: 340px 1fr;
      align-items: center;
      gap: 24px;
      padding: 14px;
    }
    .destaque-in .ph {
      aspect-ratio: 16 / 9;
    }
    .destaque-txt p {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .destaque-txt .t {
      font-size: clamp(1.25rem, 1rem + 0.9vw, 1.6rem);
    }
  }
  .destaque-txt {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .destaque-txt p {
    margin: 0;
    font: 1rem/1.45 var(--serif);
    color: var(--tinta-2);
  }
  .selo {
    justify-self: start;
    background: var(--tinta);
    color: var(--faixa);
    font: 700 0.8rem/1 var(--display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 6px 9px;
    border-radius: 4px;
  }
  .destaque-in:hover .t {
    color: var(--sirene-escura);
  }

  .manchetes {
    display: grid;
    gap: 24px;
  }
  .m-side {
    display: grid;
    gap: 24px;
  }
  /* Desktop: headline sits on the lead photo so the main story fits above the fold */
  @media (min-width: 760px) {
    .m-lead :global(.story-lead .story-link) {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
    }
    .m-lead :global(.story-lead .ph) {
      border-radius: 0;
    }
    .m-lead :global(.story-lead .story-txt) {
      position: absolute;
      inset: auto 0 0 0;
      padding: 90px 28px 24px;
      background: linear-gradient(to top, rgba(12, 14, 18, 0.92) 0%, rgba(12, 14, 18, 0.7) 55%, rgba(12, 14, 18, 0) 100%);
      color: #fff;
    }
    .m-lead :global(.story-lead .chapeu),
    .m-lead :global(.story-lead .chapeu .cat),
    .m-lead :global(.story-lead .meta) {
      color: #e9ecf1;
    }
    .m-lead :global(.story-lead .exc) {
      color: #e3e6ec;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .m-lead :global(.story-lead .play) {
      top: 14px;
      bottom: auto;
    }
    .m-lead :global(.story-lead a:hover .t) {
      color: #fff;
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-underline-offset: 5px;
    }
  }
  @media (min-width: 640px) {
    .m-side {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .manchetes {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 32px;
    }
    .m-side {
      grid-template-columns: 1fr;
      align-content: start;
    }
  }
  .faixa-4 {
    display: grid;
    gap: 24px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--linha);
  }
  @media (min-width: 640px) {
    .faixa-4 {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .faixa-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ad-leader {
    margin: 32px 0;
  }
  .feed {
    display: grid;
  }
  .feed > :global(.story) {
    padding: 18px 0;
    border-bottom: 1px solid var(--linha);
  }
  .feed > :global(.story:first-child) {
    padding-top: 0;
  }
  .feed-ad {
    padding: 20px 0;
    border-bottom: 1px solid var(--linha);
  }
  .more {
    text-align: center;
    margin-top: 24px;
  }
  .videos {
    margin-top: 48px;
  }
  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 160px;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
  }
  .rail > :global(*) {
    scroll-snap-align: start;
  }
  @media (min-width: 1000px) {
    .rail {
      grid-auto-columns: calc((100% - 5 * 14px) / 6);
    }
  }
  .cidades {
    display: grid;
    gap: 36px;
    margin-top: 48px;
  }
  @media (min-width: 700px) {
    .cidades {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1100px) {
    .cidades {
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
    }
  }
  .cidade {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .c-list {
    display: grid;
    gap: 14px;
  }
  .envie-band {
    display: grid;
    gap: 14px;
    align-items: center;
    margin-top: 48px;
    padding: 22px;
    border-radius: 10px;
    background: var(--asfalto);
    color: var(--tinta);
  }
  .envie-band > :global(svg) {
    color: var(--sirene);
  }
  @media (min-width: 760px) {
    .envie-band {
      grid-template-columns: auto 1fr auto;
      gap: 22px;
    }
  }
  .envie-band p {
    margin: 0;
    color: var(--tinta-2);
  }
  .envie-band .eb-t {
    font: 700 1.4rem/1.1 var(--display);
    color: var(--tinta);
    margin-bottom: 4px;
  }
</style>
