---
import Icon from "./Icon.astro";
interface Props {
  url: string;
  title: string;
  compact?: boolean;
}
const { url, title, compact = false } = Astro.props;
const u = encodeURIComponent(url);
const text = encodeURIComponent(`${title}\n\n${url}`);
---
<div class:list={["share", { compact }]} data-share-url={url} data-share-title={title}>
  <a class="s-wa" href={`https://api.whatsapp.com/send?text=${text}`} target="_blank" rel="noopener" aria-label="Compartilhar no WhatsApp">
    <Icon name="whatsapp" size={20} />{!compact && <span>WhatsApp</span>}
  </a>
  <a class="s-ic s-fb" href={`https://www.facebook.com/sharer/sharer.php?u=${u}`} target="_blank" rel="noopener" aria-label="Compartilhar no Facebook"><Icon name="facebook" size={20} /></a>
  <a class="s-ic" href={`https://x.com/intent/post?url=${u}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" aria-label="Compartilhar no X"><Icon name="x" size={18} /></a>
  <a class="s-ic s-tg" href={`https://t.me/share/url?url=${u}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" aria-label="Compartilhar no Telegram"><Icon name="telegram" size={20} /></a>
  <button type="button" class="s-ic" data-copy aria-label="Copiar link"><Icon name="link" size={20} /></button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-share-url]").forEach((bar) => {
    const btn = bar.querySelector<HTMLButtonElement>("[data-copy]");
    btn?.addEventListener("click", async () => {
      const url = bar.dataset.shareUrl!;
      if (navigator.share && matchMedia("(pointer: coarse)").matches) {
        try { await navigator.share({ title: bar.dataset.shareTitle, url }); return; } catch { /* cancelled */ }
      }
      try {
        await navigator.clipboard.writeText(url);
        btn.setAttribute("aria-label", "Link copiado");
        btn.classList.add("ok");
        setTimeout(() => { btn.classList.remove("ok"); btn.setAttribute("aria-label", "Copiar link"); }, 1800);
      } catch { /* clipboard blocked */ }
    });
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .share a,
  .share button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    border: 0;
    border-radius: 999px;
    background: var(--asfalto);
    color: var(--tinta);
  }
  .s-ic {
    width: 42px;
  }
  .s-wa {
    padding: 0 16px;
    background: var(--whats) !important;
    color: #fff !important;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .compact .s-wa {
    width: 42px;
    padding: 0;
  }
  .share a:hover,
  .share button:hover {
    background: var(--linha);
  }
  .s-wa:hover {
    background: var(--whats-escuro) !important;
  }
  .s-fb { color: #1b62d6 !important; }
  .s-tg { color: #229ed9 !important; }
  .share button.ok {
    background: var(--tinta);
    color: #fff;
  }
</style>
