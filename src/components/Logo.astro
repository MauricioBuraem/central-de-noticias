---
// Official Central de Notícias logo (white wordmark with the green-red-yellow bar on black).
interface Props {
  as?: "div" | "h1";
  height?: number;
}
const { as: Tag = "div", height = 44 } = Astro.props;
const width = Math.round(height * 2.72);
---
<Tag class="logo">
  <a href="/" aria-label="Central de Notícias, página inicial">
    <img
      src="/logo-central.png"
      srcset="/logo-central.png 1x, /logo-central-2x.png 2x"
      width={width}
      height={height}
      alt="Central de Notícias"
      fetchpriority="high"
    />
  </a>
</Tag>

<style>
  .logo {
    margin: 0;
    font-size: 1rem;
    line-height: 0;
  }
  .logo a {
    display: inline-block;
    background: #000;
    border-radius: 4px;
  }
  .logo img {
    display: block;
  }
</style>
