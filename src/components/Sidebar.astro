---
import Icon from "./Icon.astro";
import AdSlot from "./AdSlot.astro";
import MostRead from "./MostRead.astro";
import type { Card } from "../lib/db";
import { CONTACT, SOCIAL } from "../lib/config";
interface Props { mostRead: Card[] }
const { mostRead } = Astro.props;
---
<aside class="sidebar stack" aria-label="Destaques e contato">
  <MostRead posts={mostRead} />
  <AdSlot size="box" />
  <section class="box-whats">
    <p class="bw-t">A Central no seu WhatsApp</p>
    <p class="bw-s">Mais de mil vizinhos já recebem as notícias da região direto no celular.</p>
    <a class="btn btn-whats" href={CONTACT.whatsappGroup} target="_blank" rel="noopener"><Icon name="whatsapp" />Entrar no grupo</a>
  </section>
  <section class="box-envie">
    <p class="bw-t">Aconteceu perto de você?</p>
    <p class="bw-s">Envie vídeo, foto ou denúncia. A Central apura e publica. Sua identidade é preservada.</p>
    <a class="btn btn-sirene" href="/envie-sua-noticia/"><Icon name="camera" />Enviar notícia</a>
  </section>
  <section>
    <div class="sec-h"><h2>Siga a Central</h2></div>
    <ul class="follow">
      {SOCIAL.filter((s) => s.url && s.key !== "whatsapp").map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener" class={`f-${s.key}`}><Icon name={s.key} size={22} />{s.label}</a></li>
      ))}
    </ul>
  </section>
</aside>
<style>
  .box-whats,
  .box-envie {
    padding: 18px;
    border-radius: 10px;
    background: #e7f6ed;
  }
  .box-envie {
    background: #fdece7;
  }
  .bw-t {
    margin: 0 0 6px;
    font: 700 1.25rem/1.1 var(--display);
  }
  .bw-s {
    margin: 0 0 14px;
    font-size: 0.92rem;
    color: var(--tinta-2);
  }
  .follow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .follow a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--asfalto);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .follow a:hover {
    background: var(--linha);
  }
  .f-instagram { color: #c1356b; }
  .f-youtube { color: #d4201b; }
  .f-facebook { color: #1b62d6; }
  .f-tiktok, .f-kwai { color: var(--tinta); }
</style>
