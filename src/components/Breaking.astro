---
import type { Card } from "../lib/db";
import { postPath, timeAgo } from "../lib/format";
interface Props { posts: Card[] }
const { posts } = Astro.props;
const p = posts[0];
---
{p && (
  <div class="urgente" role="region" aria-label="Notícia urgente">
    <div class="wrap urgente-in">
      <span class="tag"><span class="pulse" aria-hidden="true"></span>Urgente</span>
      <a href={postPath(p)} class="u-t">{p.title.replace(/^(urgente|exclusivo)\s*[:!-]\s*/i, "")}</a>
      <time class="u-time" datetime={p.published_at} data-ago>{timeAgo(p.published_at)}</time>
    </div>
  </div>
)}
<style>
  .urgente {
    background: var(--faixa);
    color: var(--tinta);
  }
  .urgente-in {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .tag {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--tinta);
    color: var(--faixa);
    font: 700 0.9rem/1 var(--display);
    text-transform: uppercase;
    padding: 7px 10px;
    border-radius: 4px;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff3b2f;
    animation: pulse 1.4s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 59, 47, 0.7); }
    100% { box-shadow: 0 0 0 9px rgba(255, 59, 47, 0); }
  }
  .u-t {
    font: 600 1.02rem/1.15 var(--display);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .u-t:hover {
    text-decoration: underline;
  }
  .u-time {
    margin-left: auto;
    flex: none;
    font: 600 0.78rem/1 var(--ui);
  }
  @media (max-width: 560px) {
    .u-time { display: none; }
  }
</style>
